SECUREMAILSCOPE_ENV=production
SECUREMAILSCOPE_DOMAIN=localhost
SECUREMAILSCOPE_MAX_UPLOAD_BYTES=52428800
SECUREMAILSCOPE_JOB_TIMEOUT_SECONDS=600
SECUREMAILSCOPE_ZEEK_TIMEOUT_SECONDS=300
SECUREMAILSCOPE_ZEEK_MAX_RECORDS_PER_LOG=10000
SECUREMAILSCOPE_RETENTION_DAYS=30
SECUREMAILSCOPE_RETENTION_INTERVAL_SECONDS=86400
SECUREMAILSCOPE_RETENTION_DRY_RUN=false
SECUREMAILSCOPE_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
SECUREMAILSCOPE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GRAFANA_ADMIN_USER=admin
